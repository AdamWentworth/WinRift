RIOT_API_KEY=replace_with_server_riot_key
ENVIRONMENT=production
HTTP_ADDR=:8000
DEFAULT_PLATFORM=NA1

# Keep private to the home LAN. Use 127.0.0.1 and an SSH tunnel if you want stricter access.
WINRIFT_API_BIND=0.0.0.0
WINRIFT_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WINRIFT_STORAGE_MOUNT=/mnt/storage
WINRIFT_CLICKHOUSE_DATA_DIR=/mnt/storage/clickhouse/data
WINRIFT_CLICKHOUSE_LOG_DIR=/mnt/storage/clickhouse/logs
WINRIFT_CLICKHOUSE_BACKUP_DIR=/mnt/storage/clickhouse/backups
WINRIFT_RUNTIME_STATE_DIR=/srv/winrift/runtime
WINRIFT_SCHEMA_FILE=/srv/winrift/schema.sql

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=winrift
CLICKHOUSE_PASSWORD=replace_with_strong_password
CLICKHOUSE_DATABASE=winrift

RIOT_MIN_REQUEST_INTERVAL_MS=75
RIOT_RATE_LIMIT_MAX_RETRIES=3
RIOT_RATE_LIMIT_MAX_SLEEP_SECONDS=120
RIOT_AUTH_FAILURE_EXIT=true
RIOT_AUTH_FAILURE_MARKER_PATH=/run/winrift/riot-auth-failed

COLLECTOR_PLATFORMS=NA1,EUW1,EUN1,KR,BR1,LA1,LA2,JP1,OC1,TR1,RU,SG2,TW2,VN2
COLLECTOR_DEFAULT_MATCH_COUNT=20
COLLECTOR_CURRENT_PATCH=16.11
COLLECTOR_PATCH_RETENTION_COUNT=2
COLLECTOR_PRUNE_OLD_PATCHES_ON_START=false
COLLECTOR_INTERVAL_SECONDS=120
COLLECTOR_IDLE_SLEEP_SECONDS=15
COLLECTOR_FRONTIER_BATCH_SIZE=3
COLLECTOR_MAX_REQUESTS_PER_PASS=0
COLLECTOR_RATE_LIMIT_REQUESTS=100
COLLECTOR_RATE_LIMIT_WINDOW_SECONDS=120
COLLECTOR_RATE_LIMIT_RESERVE_REQUESTS=10
COLLECTOR_RECHECK_HOURS=24
COLLECTOR_DISCOVERY_DELAY_MINUTES=60
COLLECTOR_AUTO_SEED_CHALLENGER=false
COLLECTOR_AUTO_SEED_LIMIT_PER_PLATFORM=3
COLLECTOR_SEED_RIOT_IDS=
COLLECTOR_SEED_PUUIDS=

RANK_ENRICHMENT_ENABLED=false
RANK_SNAPSHOT_TTL_HOURS=24
RANK_ENRICHMENT_MAX_REQUESTS_PER_PASS=5
LIVE_RANK_ENRICHMENT_ENABLED=true
LIVE_RANK_MAX_REQUESTS=10
LIVE_BACKFILL_ENABLED=true
LIVE_BACKFILL_MIN_CHAMPION_GAMES=5
LIVE_BACKFILL_MAX_SEEDS=10
LIVE_BACKFILL_PRIORITY=95
LIVE_BACKFILL_DELAY_SECONDS=0

ACCOUNT_ALIAS_ENRICHMENT_ENABLED=true
ACCOUNT_ALIAS_MAX_REQUESTS_PER_PASS=3

ITEM_SLOT_ANALYTICS_REFRESH_ENABLED=true
ITEM_SLOT_ANALYTICS_REFRESH_INTERVAL_MINUTES=10
CHAMPION_GUIDE_ANALYTICS_REFRESH_ENABLED=true
CHAMPION_GUIDE_ANALYTICS_REFRESH_INTERVAL_MINUTES=10
WIN_CONDITION_ANALYTICS_REFRESH_ENABLED=true
WIN_CONDITION_ANALYTICS_REFRESH_INTERVAL_MINUTES=15
SUMMONER_PROFILE_ANALYTICS_REFRESH_ENABLED=true
SUMMONER_PROFILE_ANALYTICS_REFRESH_INTERVAL_MINUTES=10

MONITOR_API_HEALTH_URL=http://api:8000/api/health
MONITOR_INTERVAL_SECONDS=60
MONITOR_WORKER_HEARTBEAT_PATH=/run/winrift/worker-heartbeat.json
MONITOR_WORKER_REQUIRED=true
MONITOR_WORKER_STALE_AFTER_MINUTES=15
MONITOR_WORKER_CONTAINER_NAME=winrift_worker
MONITOR_DOCKER_SOCKET_PATH=/var/run/docker.sock
MONITOR_STARTUP_GRACE_SECONDS=120
MONITOR_ALERT_STATE_PATH=/run/winrift/monitor-alert-state.json
MONITOR_ALERT_COOLDOWN_MINUTES=360

ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
